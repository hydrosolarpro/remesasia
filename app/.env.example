EXPO_PUBLIC_SUPABASE_URL=https://vddyynachdgqmtofqxnr.supabase.co
# Settings > API > Project API keys > anon/public (NO uses la service_role aquí)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dominio público para los enlaces de invitación (admin -> Operador Perú,
# Operador Perú -> cliente). Sin esto, los enlaces copiados apuntan a
# localhost:8081 y no son clickeables desde WhatsApp. Cuando despliegues el
# panel web (Vercel), pon aquí ese dominio con https://.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:8081
