# Proyecto Supabase de Remesas IA: https://supabase.com/dashboard/project/vddyynachdgqmtofqxnr
EXPO_PUBLIC_SUPABASE_URL=https://vddyynachdgqmtofqxnr.supabase.co
# Settings > API > Project API keys > anon/public (NO uses la service_role aquí)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dominio público para los enlaces de invitación (admin -> Operador Perú,
# Operador Perú -> cliente). Sin esto, los enlaces copiados apuntan a
# localhost:8081 y no son clickeables desde WhatsApp. Cuando despliegues el
# panel web (Vercel), pon aquí ese dominio con https://.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:8081

# Landing de captación de clientes (proyecto "remesas-perú-venezuela---envíoya",
# desplegado aparte en Vercel). El botón "Compartir por WhatsApp" de
# Clientes arma el enlace ?op=<token> contra este dominio. Sin esta
# variable, el código cae a un dominio viejo (ai.studio) que ya no se
# mantiene -- ver lib/invitaciones.ts.
EXPO_PUBLIC_LANDING_BASE_URL=https://remesas-envioya.vercel.app
